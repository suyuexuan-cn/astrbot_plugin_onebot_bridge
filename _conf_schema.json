{
  "websocket_clients": {
    "description": "网络配置列表",
    "type": "template_list",
    "hint": "配置要连接的副Bot网络服务端点",
    "default": [],
    "templates": {
      "HTTP 服务器": {
        "name": "HTTP 服务器",
        "hint": "配置一个HTTP服务器来接收副Bot的消息",
        "items": {
          "name": {
            "description": "名称",
            "type": "string",
            "default": "http_server",
            "hint": "服务器标识名称"
          },
          "enable": {
            "description": "启用",
            "type": "bool",
            "default": true,
            "hint": "保存后启用此配置"
          },
          "debug": {
            "description": "开启Debug",
            "type": "bool",
            "default": false,
            "hint": "是否开启调试模式"
          },
          "host": {
            "description": "Host",
            "type": "string",
            "default": "127.0.0.1",
            "hint": "HTTP服务器监听地址"
          },
          "port": {
            "description": "Port",
            "type": "int",
            "default": 3000,
            "hint": "HTTP服务器监听端口"
          },
          "enable_cors": {
            "description": "启用CORS",
            "type": "bool",
            "default": true,
            "hint": "是否启用CORS跨域"
          },
          "enable_websocket": {
            "description": "启用Websocket",
            "type": "bool",
            "default": false,
            "hint": "在同端口额外提供反向 WebSocket 端点 /ws，可同时主动推送事件"
          },
          "report_self_message": {
            "description": "上报自身消息",
            "type": "bool",
            "default": false,
            "hint": "是否转发机器人自身账号发出的消息（关闭可避免消息回灌）"
          },
          "enable_force_push_event": {
            "description": "推送非消息事件",
            "type": "bool",
            "default": true,
            "hint": "是否推送 notice（成员变动/禁言/撤回/戳一戳）与 request（加好友/加群）事件"
          },
          "message_post_format": {
            "description": "消息格式",
            "type": "string",
            "default": "array",
            "options": ["array", "string"],
            "hint": "消息格式：array或string"
          },
          "token": {
            "description": "Token",
            "type": "string",
            "default": "",
            "hint": "HTTP访问的验证令牌"
          }
        }
      },
      "HTTP SSE 服务器": {
        "name": "HTTP SSE 服务器",
        "hint": "配置一个HTTP SSE服务器来接收副Bot的消息",
        "items": {
          "name": {
            "description": "服务器名称",
