            "hint": "HTTP SSE服务器监听地址"
          },
          "port": {
            "description": "Port",
            "type": "int",
            "default": 3002,
            "hint": "HTTP SSE服务器监听端口"
          },
          "enable_cors": {
            "description": "启用CORS",
            "type": "bool",
            "default": true,
            "hint": "是否启用CORS跨域"
          },
          "report_self_message": {
            "description": "上报自身消息",
            "type": "bool",
            "default": false,
            "hint": "是否转发机器人自身账号发出的消息（关闭可避免消息回灌）"
          },
          "enable_force_push_event": {
            "description": "推送非消息事件",
            "type": "bool",
            "default": true,
            "hint": "是否推送 notice（成员变动/禁言/撤回/戳一戳）与 request（加好友/加群）事件"
          },
          "message_post_format": {
            "description": "消息格式",
            "type": "string",
            "default": "array",
            "options": ["array", "string"],
            "hint": "消息格式：array或string"
          },
          "token": {
            "description": "Token",
            "type": "string",
            "default": "",
            "hint": "HTTP访问的验证令牌"
          }
        }
      },
      "HTTP 客户端": {
        "name": "HTTP 客户端",
        "hint": "配置一个HTTP客户端来连接副Bot",
        "items": {
          "name": {
            "description": "客户端名称",
            "type": "string",
            "default": "http_client",
            "hint": "客户端标识名称"
          },
          "enable": {
            "description": "启用客户端",
            "type": "bool",
            "default": true,
            "hint": "保存后启用此配置"
          },
          "debug": {
            "description": "开启Debug",
            "type": "bool",
            "default": false,
            "hint": "是否开启调试模式"
          },
          "base_url": {
            "description": "基础URL",
            "type": "string",
            "default": "http://localhost:3000",
            "hint": "HTTP服务端基础URL地址"
          },
          "report_self_message": {
            "description": "上报自身消息",
            "type": "bool",
            "default": false,
            "hint": "是否上报自身消息"
          },
          "enable_force_push_event": {
            "description": "强制推送事件",
            "type": "bool",
            "default": true,
            "hint": "是否强制推送事件"
          },
          "message_post_format": {
            "description": "消息格式",
            "type": "string",
            "default": "array",
            "options": ["array", "string"],
            "hint": "消息格式：array(数组)或string(字符串)"
          },
          "token": {
            "description": "Token",
            "type": "string",
            "default": "",
            "hint": "HTTP连接的访问令牌"
          },
          "timeout": {
            "description": "请求超时 (秒)",
            "type": "int",
            "default": 30,
            "hint": "HTTP 请求超时时间 (秒)"
          },
          "endpoint": {
            "description": "API端点",
            "type": "string",
            "default": "/onebot/v11",
            "hint": "HTTP API 端点路径"
          },
          "enable_group_forward": {
            "description": "启用群消息转发",
            "type": "bool",
            "default": true,
            "hint": "是否转发群消息到此副 Bot"
          },
          "enable_private_forward": {
            "description": "启用私聊消息转发",
            "type": "bool",
            "default": false,
            "hint": "是否转发私聊消息到此副 Bot"
          },
          "command_prefix": {
            "description": "命令前缀",
            "type": "string",
            "default": "",
            "hint": "触发转发的命令前缀，匹配后去除前缀转发剩余内容"
          },
          "forward_fprefix": {
            "description": "转发前缀",
            "type": "list",
            "default": [],
            "hint": "前缀匹配，消息以指定前缀开头时完整转发到此副 Bot"
          },
          "forward_keyword": {
            "description": "转发关键字",
            "type": "list",
            "default": [],
            "hint": "触发转发的关键字，消息包含关键字时转发完整消息到此副 Bot"
          }
        }
      },
